{
  "type": "object",
  "required": ["through_line", "verdict", "notes", "read", "log_check"],
  "additionalProperties": false,
  "properties": {
    "through_line": {"type": "string"},
    "verdict": {"type": "string", "enum": ["accept", "revise", "redraft"]},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote", "problem"],
        "additionalProperties": false,
        "properties": {
          "quote": {"type": "string"},
          "problem": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    },
    "read": {"type": "string"},
    "log_check": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["log_order", "lifted", "same_weight", "cut", "missing"],
          "additionalProperties": false,
          "properties": {
            "log_order": {"type": "boolean"},
            "lifted": {"type": "array", "items": {"type": "string"}},
            "same_weight": {"type": "string"},
            "cut": {"type": "array", "items": {"type": "string"}},
            "missing": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    }
  }
}
