{
  "type": "object",
  "required": ["fields", "reason"],
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "object",
      "required": ["epithet", "allegiance", "circles"],
      "additionalProperties": false,
      "properties": {
        "epithet": {"type": "string"},
        "allegiance": {
          "type": ["string", "null"],
          "enum": ["with", "against", null]
        },
        "circles": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "uniqueItems": true
        }
      }
    },
    "reason": {"type": "string"}
  }
}
